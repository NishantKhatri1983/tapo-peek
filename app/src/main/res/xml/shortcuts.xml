<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="pause60"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_pause">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nishant.stairscam"
            android:targetClass="com.nishant.stairscam.SnoozeActivity">
            <extra android:name="minutes" android:value="60" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="resume"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_resume">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nishant.stairscam"
            android:targetClass="com.nishant.stairscam.SnoozeActivity">
            <extra android:name="minutes" android:value="0" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nishant.stairscam"
            android:targetClass="com.nishant.stairscam.SettingsActivity" />
    </shortcut>
</shortcuts>
